VITE_API_BASE_URL=/api
# Cible serveur du proxy Vite (jamais exposée directement au navigateur).
# Pour une API locale : http://127.0.0.1:8000
TESS_BACKEND_URL=http://127.0.0.1:8000
# Optional hosted TESS Gateway base URL, for example https://api.example.tld/api/v1
# Leave empty locally: Vite proxies /api/v1/* to the local TESS API.
VITE_TESS_API_BASE_URL=
# AWS TESS API/WebSocket (use these names for the deployed frontend).
VITE_TESS_API_URL=
VITE_TESS_WS_URL=
